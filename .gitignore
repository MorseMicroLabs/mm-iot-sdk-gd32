# Build output.
# Deliberately scoped to build directories rather than using global patterns like
# *.o / *.map -- the SDK tracks 114 Doxygen-generated .map files under framework/doc/html,
# which a global rule would shadow.
build/
build_debug/
build_symbols/

# Python
__pycache__/
*.pyc
framework/.pipenv-synced

# Vendor / dev-board resource packs. These are multi-gigabyte downloads (the
# GD32F527ZMT7 pack alone is ~2.1GB) and are reference material, not SDK source.
/GD32F470VGT6/
/GD32F527ZMT7/
/GD32_ISP_CLI/
/GD32F4xx_Firmware_Library_V3.3.3/

# Local per-board config-store overlays. These hold the BCF path and live Wi-Fi
# credentials, which are per-site configuration and must never be committed -- the
# tracked example config.hjson files deliberately keep placeholders instead.
# See framework/src/platforms/mm-ekh18-gd32f527/bringup-quickstart.md
/bcf-local.hjson
/bcf-only.hjson
*-local.hjson

# Scratch
debug_threads_output.txt
